{
  "name": "suncity-hotel",
  "version": "1.0.0",
  "private": true,
  "description": "SUN CITY NYAKARAMBI Enterprise Hotel Management System",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:import": "npm run db:import -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
