PORT=5000
NODE_ENV=production
# Comma-separated list of allowed frontend origins
# For Render: set this to your Vercel URL, e.g. https://suncity-client.vercel.app
CLIENT_URL=https://suncity-client.vercel.app,http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Use 'mysql' for XAMPP local dev, 'sqlite' for Render free tier
DB_DRIVER=mysql

# MySQL (used when DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=suncity_hotel

# SQLite (used when DB_DRIVER=sqlite)
# Leave blank to use default path: server/suncity.db
SQLITE_PATH=

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Payments ──────────────────────────────────────────────────────────────────
PAYMENT_MODE=sandbox
MTN_MOMO_API_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_PRIMARY_KEY=
AIRTEL_MONEY_API_KEY=
STRIPE_SECRET_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=suncitynyakarambi@gmail.com

# ── Hotel info ────────────────────────────────────────────────────────────────
HOTEL_NAME=SUN CITY NYAKARAMBI Ltd
HOTEL_PHONE=+250780219057
HOTEL_PHONE_ALT=+250788525507
HOTEL_EMAIL=suncitynyakarambi@gmail.com
HOTEL_WHATSAPP=250780219057
HOTEL_WEBSITE=https://www.suncity.rw
HOTEL_ADDRESS=Nyakarambi, Kirehe District, Eastern Province, Rwanda
